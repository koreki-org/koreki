{
  "realm": "koreki",
  "enabled": true,
  "loginTheme": "koreki",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "koreki-admin",
        "description": "Koreki Administrator"
      },
      {
        "name": "koreki-user",
        "description": "Koreki Standard User"
      }
    ]
  },
  "users": [
    {
      "username": "koreki",
      "enabled": true,
      "emailVerified": true,
      "email": "koreki@koreki.local",
      "firstName": "Koreki",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "koreki",
          "temporary": false
        }
      ],
      "realmRoles": [
        "koreki-admin",
        "koreki-user"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "koreki-app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ]
}
