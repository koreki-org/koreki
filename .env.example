# ==============================================================================
# KOREKI ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and adjust the values for your deployment tier.

# ------------------------------------------------------------------------------
# 1. GLOBAL SETTINGS (Mandatory for all versions)
# ------------------------------------------------------------------------------
# Deployment Mode: saas | community | desktop
NEXT_PUBLIC_KOREKI_MODE=community

# The public URL where the app is reachable
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Primary AI Key (Mistral AI) - Used as fallback or system default
MISTRAL_API_KEY=your_mistral_key_here

# OpenAI-Compatible / Qwen Provider Settings (Global Fallbacks)
OPENAI_API_KEY=sk-cmJri_h1HV9RlV6U-_VRKQ
OPENAI_API_BASE=https://llm.aihosting.mittwald.de/v1
OPENAI_API_MODEL=Qwen3.6-35B-A3B-FP8
MITTWALD_API_KEY=your_key_here # Legacy alias for OPENAI_API_KEY


# ------------------------------------------------------------------------------
# 2. TIER: COMMUNITY (SINGLE USER / HOME)
# ------------------------------------------------------------------------------
# Set to true to bypass all authentication and billing. 
# Ideal for local desktop use or private home servers.
NEXT_PUBLIC_SINGLE_USER_MODE=false


# ------------------------------------------------------------------------------
# 3. TIER: COMMUNITY (MULTI-USER / SCHOOLS)
# ------------------------------------------------------------------------------
# Identity Provider: KEYCLOAK | LOGTO | NONE
NEXT_PUBLIC_AUTH_TYPE=KEYCLOAK

# Keycloak / OIDC Configuration
NEXT_PUBLIC_OIDC_ISSUER=https://your-keycloak.com/realms/your-realm
NEXT_PUBLIC_OIDC_CLIENT_ID=koreki-app

# Settings Governance (Admin Role)
# Only users with this role in Keycloak can see the gear icon & setup modal.
# Default: Admin. For school networks, you might want "koreki-admin".
NEXT_PUBLIC_ADMIN_ROLE_NAME=Admin


# ------------------------------------------------------------------------------
# 4. TIER: SAAS (ENTERPRISE / CLOUD)
# ------------------------------------------------------------------------------
# Identity Provider (Logto)
LOGTO_ENDPOINT=https://auth.koreki.org
LOGTO_APP_ID=your_logto_app_id
LOGTO_APP_SECRET=your_logto_app_secret
LOGTO_COOKIE_SECRET=a_long_random_string_32_chars_at_least

# Logto Management (M2M) - Used for role sync and user management
LOGTO_MGMT_APP_ID=
LOGTO_MGMT_APP_SECRET=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_MODE=true


# ------------------------------------------------------------------------------
# 5. OPTIONAL FEATURES & COMPLIANCE
# ------------------------------------------------------------------------------
# Legal Info (Imprint & Privacy)
NEXT_PUBLIC_LEGAL_NAME="Your Organization Name"
NEXT_PUBLIC_LEGAL_ADDRESS="Street 1, 12345 City"
NEXT_PUBLIC_LEGAL_EMAIL="support@example.com"
NEXT_PUBLIC_LEGAL_TAX_ID=""

# Contact Form (SendGrid)
SENDGRID_API_KEY=
CONTACT_FORM_RECEIVER_EMAIL=support@example.com
SENDGRID_SENDER_EMAIL=noreply@example.com


# ------------------------------------------------------------------------------
# 6. DEVELOPMENT & TESTING
# ------------------------------------------------------------------------------
E2E_TEST_USER=
E2E_TEST_PASSWORD=
NODE_ENV=development
